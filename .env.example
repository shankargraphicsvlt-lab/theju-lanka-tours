# Copy to .env.local and fill in real values. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are embedded in browser code. Never put secrets in them.

# ---- Site ----
# Production origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Leave unset locally; defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---- Social profiles (shown on the site) ----
# Phone, WhatsApp, email, address and legal details are set in src/config/contact.ts, not here.
# Social profile links (https://...). Footer icons appear only for the ones set.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ---- Phase D: Supabase (see docs/supabase-setup-windows.md) ----
# Nothing connects to Supabase unless these are filled in. The staff area (/admin) exists
# only once the URL and publishable key are set. Trip enquiries, contact-message backups and
# newsletter sign-ups are stored only when BOOKING_SUBMISSIONS_ENABLED=true AND all four
# values below are set.
BOOKING_SUBMISSIONS_ENABLED=false
# Project URL, e.g. https://<project-ref>.supabase.co (public)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_ (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, starts with sb_secret_ (SERVER ONLY, bypasses Row Level Security, never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
# Random value used to hash visitor IPs for rate limiting (SERVER ONLY)
SUBMITTER_HASH_SALT=

# ---- Contact form email (Resend, https://resend.com) ----
# Contact-form messages are emailed to the business address in src/config/contact.ts.
# Create the Resend account with that same address: until you verify a domain in Resend,
# mail can only be sent from onboarding@resend.dev to the account owner's address.
RESEND_API_KEY=                   # server only, starts with re_
# Optional sender once a domain is verified in Resend, e.g. "GSKT Lanka Tours <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# ---- Payments (not used yet) ----
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=        # server only
# PAYHERE_SANDBOX=true
